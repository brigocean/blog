{
    "name": "test/blog",
    "description": "Простой блог на чистом PHP, MySQL и Smarty",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "smarty/smarty": "^5.4"
    },
    "require-dev": {
        "scssphp/scssphp": "^1.13"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "migrate": "php bin/migrate.php",
        "seed": "php bin/seed.php",
        "build-css": "php bin/build-css.php"
    },
    "config": {
        "sort-packages": true
    }
}
